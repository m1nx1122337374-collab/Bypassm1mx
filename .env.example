# Optional shared secret. If empty, the API is public.
API_KEY=
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10
MAX_REDIRECTS=10
MAX_HTML_REDIRECTS=3
MAX_HTML_BYTES=1048576
MAX_URL_LENGTH=4096
USER_AGENT=authorized-url-resolver/1.0
# Keep true on public deployments to reduce SSRF risk.
BLOCK_PRIVATE_NETWORKS=true
# Optional comma-separated exact host allowlist, e.g. short.example.com
ALLOWED_HOSTS=
